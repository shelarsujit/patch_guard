# Copy to .env and fill in. .env is gitignored and never enters a cassette.
#
# Only needed to RE-RECORD cassettes (`make baseline-record` / `make agent-record`).
# Replaying the committed cassettes — which is what `make baseline`, `make agent`
# and `make eval` do — needs no key and no network.

# Worker model provider. Free tier: 30 req/min, 1000 req/day, 200k tokens/day.
# https://console.groq.com
GROQ_API_KEY=

# Documented fallback if the Groq free tier's tokens/day ceiling bites.
# Set PATCHGUARD_MODEL=openrouter/deepseek/deepseek-r1:free to use it.
OPENROUTER_API_KEY=
