# Copy to .env and fill in. .env is gitignored and never enters a cassette.
#
# Only needed to RE-RECORD cassettes (`python run.py record`). Replaying the
# committed cassettes -- which is what `python run.py baseline agent eval` does,
# and what reproduces the published numbers -- needs no key and no network.

# Default worker provider. Serves openai/gpt-oss-20b with no daily token
# ceiling; a full sweep costs roughly $0.03.
# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Free fallback, same model weights. Set PATCHGUARD_MODEL=groq/openai/gpt-oss-20b
# to use it. Note the free tier enforces 200,000 tokens/day on top of its
# advertised 8,000 tokens/minute -- a limit that appears in no x-ratelimit-*
# header and is only discoverable by crossing it. A full sweep needs several
# times that, so recording on Groq means rationing across days.
# https://console.groq.com
GROQ_API_KEY=
